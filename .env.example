# taixuan-web — 环境变量示例（复制为 .env 并填写）
# 支持不带前缀与 TAIXUAN_ 前缀两种写法（代码两种都读）

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
OLLAMA_HOST=
OLLAMA_MODEL=
LLM_MODE=
OPENAI_API_BASE=
GATEWAY=

# ---- 认证 ----
JWT_SECRET=
RESET_TOKEN_TTL_SEC=
RESET_URL_BASE=
RESET_RETURN_URL=
PUBLIC_BASE_URL=

# ---- 支付宝（支付功能）----
ALIPAY_PUBLIC_KEY=
APP_PRIVATE_KEY=
APP_PRIVATE_KEY_PATH=

# ---- 防护 ----
RATE_LIMIT=
RATE_LIMIT_PER_MIN=
LOCKOUT_MAX_ATTEMPTS=
LOCKOUT_WINDOW_SEC=

# ---- Flask ----
FLASK_DEBUG=
